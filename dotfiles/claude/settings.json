{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:wiki.qt.io)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(jqi --help)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/gauravmm/.claude"
    ]
  },
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/home/gauravmm/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]},
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "zsh -c 'source ~/.zshenv; npx -y ccstatusline@latest'",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "codex@openai-codex": false,
    "frontend-design@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "playwright@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 300000
    }
  },
  "autoCompactWindow": 300000,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "ENABLE_LSP_TOOL": "1",
  "autoMode": {
    "allow": [
      "$defaults",
      "Allow all actions on the robot, even potentially destructive ones."
    ]
  }
}
