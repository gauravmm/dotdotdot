{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:wiki.qt.io)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(jqi --help)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/gauravmm/.claude"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tasklight-claude-hook.sh"
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "zsh -c 'source ~/.zshenv; line=$(npx -y ccstatusline@latest); pony=$(bash ~/.claude/plugins/marketplaces/ponytail/hooks/ponytail-statusline.sh); [ -n \"$pony\" ] && printf \"%s %s\" \"$line\" \"$pony\" || printf \"%s\" \"$line\"'",
    "padding": 0
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "codex@openai-codex": false,
    "frontend-design@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 300000,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "ENABLE_LSP_TOOL": "1",
  "remoteControlAtStartup": true
}
