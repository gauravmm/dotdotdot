#!/bin/bash
set -e

# Global Claude Code config. Newest copy wins, in both directions — same
# convention as zsh.dotsh.
# ponytail: only user-level config. Per-project CLAUDE.md lives in its own repo;
# settings.local.json is deliberately not synced — it is the per-machine override.

mkdir -p hooks "${HOME}/.claude/hooks" "${HOME}/.config/ccstatusline"

sync2() {
	[ -f "$1" ] && rsync -rtuv "$1" "$2"
	[ -f "$2" ] && rsync -rtuv "$2" "$1"
	return 0
}

sync2 CLAUDE.md         "${HOME}/.claude/CLAUDE.md"
sync2 settings.json     "${HOME}/.claude/settings.json"      # incl. statusLine, hooks, plugins
sync2 ccstatusline.json "${HOME}/.config/ccstatusline/settings.json"
sync2 hooks/tasklight-claude-hook.sh "${HOME}/.claude/hooks/tasklight-claude-hook.sh"
